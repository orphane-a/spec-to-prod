# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais commité.
# Ne jamais définir ANTHROPIC_API_KEY : le serveur refuse de démarrer si elle existe.

PORT=3000
# Adresse d'écoute : 127.0.0.1 sur ton poste, 0.0.0.0 dans le conteneur du VPS
HOST=127.0.0.1
# Mot de passe du tableau (au moins 12 caractères). Obligatoire en mode reel ou hors écoute locale.
MOT_DE_PASSE=
# Chemin du fichier SQLite
BASE_CHEMIN=donnees/spec-to-prod.db
# simule (par défaut) ou reel. Le mode reel est décrit dans taches-cloud/MISE_EN_ROUTE.md
CLAUDE_MODE=simule
# Délai du faux Claude entre deux étapes, en millisecondes
SIMULATION_DELAI_MS=3000
# Nombre maximum d'itérations de la boucle de dev
ITERATIONS_MAX=5
# Secret partagé pour signer les webhooks de fin de run (au moins 32 caractères).
# Facultatif en mode simulé : un secret éphémère est généré au démarrage.
WEBHOOK_SECRET=

# Minutes sans nouvelles d'une session avant de bloquer son ticket
RUN_SILENCE_MAX_MIN=60

# Mode reel : toutes les valeurs ci dessous sont obligatoires.
# Adresse publique en https du relais, joignable depuis les sessions cloud
RELAIS_URL_PUBLIQUE=
# Jeton GitHub à droits fins : Actions en lecture et écriture sur les dépôts des projets, rien d'autre
GITHUB_JETON=
# Une tâche cloud par étape : URL https://api.anthropic.com/v1/claude_code/routines/trig_.../fire et son jeton
ROUTINE_SPEC_URL=
ROUTINE_SPEC_JETON=
ROUTINE_DESIGN_URL=
ROUTINE_DESIGN_JETON=
ROUTINE_DEV_URL=
ROUTINE_DEV_JETON=
