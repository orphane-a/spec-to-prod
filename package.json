{
  "name": "spec-to-prod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kanban personnel qui pilote les projets Claude du backlog à la mise en production",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n serveur,web \"tsx watch src/serveur/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/serveur/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "dompurify": "^3.4.18",
    "fastify": "^5.12.8",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
